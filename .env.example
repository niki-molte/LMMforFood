# =============================================================================
# LLMforFood - environment variables template
# Copy this file to ".env" (in the project root) and fill in the values.
# The ".env" file is excluded from git: NEVER commit real keys.
# =============================================================================

# --- Google AI Studio models ---
GOOGLE_GEMMA_31B=gemma-4-31b-it
GOOGLE_GEMMA_26B=gemma-4-26b-a4b-it

# --- OpenRouter models ---
OPENROUTER_GEMMA_31B=google/gemma-4-31b-it:free
OPENROUTER_MINIMAX_M2.5=minimax/minimax-m2.5:free

# --- HuggingFace Inference models ---
HUGGINGFACE_GEMMA_31B=google/gemma-4-31B-it
HUGGINGFACE_GPT_OSS_20B=openai/gpt-oss-20b
HUGGINGFACE_QWEN_3.5_27B=Qwen/Qwen3.5-27B

# --- Ollama models (local execution) ---
OLLAMA_QWEN_3.5_0.8B=qwen3.5:0.8b
OLLAMA_QWEN_3.5_4B=qwen3.5:4b
OLLAMA_GEMMA_4_E2B_Q4=gemma4:e2b
OLLAMA_GEMMA_4_E2B_Q8=gemma4:e2b-it-q8_0
OLLAMA_GEMMA_4_E4B_Q8=gemma4:e4b-it-q8_0
OLLAMA_MINICPM_V4.5_8B=openbmb/minicpm-v4.5:8b

# --- Local dataset paths ---
# Nutrition5k root folder (contains imagery/, metadata/, dish_ids/ ...)
NUTRITION5K_DATASET_DIR=/path/to/nutrition5k_dataset
